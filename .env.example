# --- Database / cache ---
DATABASE_URL=mysql+pymysql://ig_user:change_me@mysql:3306/instagram_saas
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_PASSWORD=change_me
REDIS_URL=redis://redis:6379/0
# with a Redis password: REDIS_URL=redis://:<password>@redis:6379/0 (see docker-compose.yml)

# --- Security (generate your own; never reuse examples) ---
# python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=
# shared secret between FastAPI and n8n (both directions)
N8N_API_KEY=

# --- Meta / Instagram Business Login ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://yourdomain.com/api/instagram/callback
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# --- Facebook Page connect (Facebook Login for Pages) ---
# Leave the two FB_APP_* empty to reuse META_APP_ID / META_APP_SECRET. Fill them if your
# Instagram app id/secret differ from the Meta app's main App ID / App Secret.
META_FB_APP_ID=
META_FB_APP_SECRET=
META_FB_REDIRECT_URI=https://yourdomain.com/api/facebook/callback

# --- URLs (frontend and API share one domain; nginx proxies /api) ---
FRONTEND_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com
# internal Docker address of the n8n webhook node (keep n8n off the public internet)
N8N_WEBHOOK_URL=http://n8n:5678/webhook/ig-events

# --- Runtime ---
# 1/true/yes hides /docs, /redoc and /openapi.json. Set PRODUCTION=0 locally if you want the docs.
PRODUCTION=1

# --- Seeded admin (created on first startup if missing) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
